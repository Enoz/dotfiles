# === Secrets — never commit these ===
# Provider credentials from /login (auth tokens, API keys)
auth.json
credentials.json

# === Machine-local state / caches ===
# Project trust decisions (contains machine-specific absolute paths)
trust.json
# Fetched provider model catalog cache (regenerated automatically)
models-store.json
# MCP server discovery cache (tool schemas; regenerated on server change)
mcp-cache.json
# MCP onboarding / UI state (one-time setup flags)
mcp-onboarding.json

# === Session history ===
# JSONL conversation files; churn on every run and may contain secrets pasted in chat
sessions/
# Run history log (task hashes, timestamps, durations); churns on every run
run-history.jsonl

# === Installed packages ===
# pi install writes here; sources are recorded in settings.json / package.json instead
npm/
git/
